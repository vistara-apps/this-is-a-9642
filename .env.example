# KnowMyRights.ai Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API Configuration
# Required for AI-powered script generation and incident summaries
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Pinata IPFS Configuration
# Required for decentralized storage of recordings and media
# Get your API keys from: https://app.pinata.cloud/keys
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Stripe Payment Configuration
# Required for subscription management and payments
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Optional: Backend API Configuration
# If you have a backend server for additional functionality
# VITE_API_BASE_URL=http://localhost:3001

# Optional: Analytics Configuration
# For tracking usage and performance
# VITE_ANALYTICS_ID=your_analytics_id_here

# Development Configuration
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# App Configuration
VITE_APP_NAME=KnowMyRights.ai
VITE_APP_VERSION=1.0.0
